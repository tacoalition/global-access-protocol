pragma solidity 0.8.20;

import "forge-std/Test.sol";
import "../../src/v2/SessionVerifier.sol";

/**
 * @notice Runs a REAL Groth16 proof (generated by circuits/scripts/v2/prove_session.js selftest)
 *         through the on-chain SessionVerifier: the end-to-end proof-of-life for the ZK pipeline.
 *         Regenerate the fixture with: node circuits/scripts/v2/prove_session.js selftest
 */
contract SessionVerifierTest is Test {
    SessionVerifier verifier;

    function setUp() public {
        verifier = new SessionVerifier();
    }

    function _load() internal view returns (
        uint256[2] memory pA, uint256[2][2] memory pB, uint256[2] memory pC, uint256[19] memory pub
    ) {
        string memory proofJson = vm.readFile("test/fixtures/v2/proof.json");
        string memory pubJson = vm.readFile("test/fixtures/v2/public.json");
        pA[0] = vm.parseJsonUint(proofJson, ".pA[0]");
        pA[1] = vm.parseJsonUint(proofJson, ".pA[1]");
        pB[0][0] = vm.parseJsonUint(proofJson, ".pB[0][0]");
        pB[0][1] = vm.parseJsonUint(proofJson, ".pB[0][1]");
        pB[1][0] = vm.parseJsonUint(proofJson, ".pB[1][0]");
        pB[1][1] = vm.parseJsonUint(proofJson, ".pB[1][1]");
        pC[0] = vm.parseJsonUint(proofJson, ".pC[0]");
        pC[1] = vm.parseJsonUint(proofJson, ".pC[1]");
        uint256[] memory pubArr = vm.parseJsonUintArray(pubJson, "");
        require(pubArr.length == 19, "expected 19 public signals");
        for (uint256 i = 0; i < 19; i++) pub[i] = pubArr[i];
    }

    function test_RealProofVerifiesOnChain() public view {
        (uint256[2] memory pA, uint256[2][2] memory pB, uint256[2] memory pC, uint256[19] memory pub) = _load();
        assertTrue(verifier.verifyProof(pA, pB, pC, pub), "real proof must verify");
    }

    function test_TamperedPublicInputFails() public view {
        (uint256[2] memory pA, uint256[2][2] memory pB, uint256[2] memory pC, uint256[19] memory pub) = _load();
        pub[0] = pub[0] ^ 1; // flip the account binding
        assertFalse(verifier.verifyProof(pA, pB, pC, pub), "tampered public input must fail");
    }

    function test_TamperedProofFails() public view {
        (uint256[2] memory pA, uint256[2][2] memory pB, uint256[2] memory pC, uint256[19] memory pub) = _load();
        pA[0] = addmod(pA[0], 1, 21888242871839275222246405745257275088696311157297823662689037894645226208583);
        assertFalse(verifier.verifyProof(pA, pB, pC, pub), "tampered proof must fail");
    }
}
